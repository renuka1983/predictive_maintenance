# --- Application -----------------------------------------------------------
APP_NAME="Manufacturing AI SaaS"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database --------------------------------------------------------------
# Docker Compose supplies this automatically; set it for local runs.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/manufacturing_ai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_ECHO=false

# --- Security --------------------------------------------------------------
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Maturity thresholds ---------------------------------------------------
# Volume of data required before a dimension counts as established.
MIN_MAINTENANCE_RECORDS=50
MIN_PRODUCTION_BATCHES=50
MIN_SENSOR_READINGS=500
MIN_SENSOR_MACHINE_COVERAGE=0.5
